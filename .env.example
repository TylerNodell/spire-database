# Copy to .env (which is git-ignored) and fill in. Nothing loads .env automatically:
# start the server with `node --env-file=.env src/index.js` (Node 20.6+) or export
# the variables in your shell / hosting environment.

# Secret used to sign and verify login tokens (JWT). Required: the server refuses to
# start without it, and it must be at least 32 characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# Comma-separated list of browser origins allowed to call the API (CORS), for example
# http://localhost:3000. Leave empty to send no CORS headers, which blocks browsers on
# other origins (same-origin pages and non-browser clients are unaffected).
CORS_ORIGIN=

# Set NODE_ENV=production when deployed to turn off the in-browser GraphiQL IDE.
# PORT defaults to 4000.
